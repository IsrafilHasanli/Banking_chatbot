AUTH_PROVIDER=postgres

DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_chatbot
DB_USER=banking_user
DB_PASS=change_me
# DATABASE_URL=postgresql+asyncpg://banking_user:change_me@localhost:5432/banking_chatbot
SQLALCHEMY_ECHO=false

SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-latest

AWS_CLIENT_ID=your_cognito_app_client_id
AWS_REGION=your_aws_region
AWS_USER_POOL_ID=your_cognito_user_pool_id
# AWS credentials should normally be provided by the AWS SDK credential chain.
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

SMTP_SERVER=your_smtp_host
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace_with_qdrant_api_key
CHAT_CACHE_ENABLED=true
CHAT_CACHE_TTL_SECONDS=3600
CHAT_SEMANTIC_CACHE_ENABLED=true
CHAT_SEMANTIC_CACHE_THRESHOLD=0.80
